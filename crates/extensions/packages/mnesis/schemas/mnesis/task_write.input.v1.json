{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis task_write arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "projects",
        "global",
        "personal",
        "learning"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "activeForm": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ],
            "default": "pending"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "default": "medium"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 20
          },
          "blockedBy": {
            "$ref": "#/properties/tasks/items/properties/id"
          },
          "notes": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "content",
          "activeForm"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "replace": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "category",
    "tasks"
  ],
  "additionalProperties": false
}
