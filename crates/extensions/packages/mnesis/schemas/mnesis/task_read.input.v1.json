{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis task_read arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "projects",
        "global",
        "personal",
        "learning"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "status_filter": {
      "type": "string",
      "enum": [
        "all",
        "pending",
        "in_progress",
        "completed",
        "blocked",
        "active"
      ],
      "default": "active"
    }
  },
  "additionalProperties": false
}
