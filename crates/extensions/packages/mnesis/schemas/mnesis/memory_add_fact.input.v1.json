{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis memory_add_fact arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "fact_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "fact": {
      "type": "string",
      "minLength": 1,
      "description": "The fact to remember"
    },
    "source_session": {
      "type": "string",
      "minLength": 1,
      "description": "Which session this came from"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.9
    },
    "related_neurons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Stable retry identity"
    }
  },
  "required": [
    "category",
    "fact_key",
    "fact",
    "source_session"
  ],
  "additionalProperties": false
}
