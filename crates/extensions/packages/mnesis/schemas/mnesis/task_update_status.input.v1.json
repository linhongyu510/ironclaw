{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis task_update_status arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "projects",
        "global",
        "personal",
        "learning"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "blocked",
        "archived"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [
    "category",
    "task_id",
    "status"
  ],
  "additionalProperties": false
}
