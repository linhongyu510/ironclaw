{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis reflexes arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "type": {
      "default": "all",
      "description": "Which reflexes to show",
      "type": "string",
      "enum": [
        "all",
        "results",
        "tiers"
      ]
    },
    "limit": {
      "default": 20,
      "description": "Max reflexes to display",
      "type": "number"
    }
  }
}
