{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mnesis memory_feedback arguments",
  "description": "Published by the Mnesis MCP lane at runtime and captured verbatim; the engine remains authoritative for validation.",
  "type": "object",
  "properties": {
    "memory_id": {
      "type": "string",
      "description": "ID of the episodic memory"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "good",
        "bad"
      ],
      "description": "Whether this memory was useful"
    },
    "context": {
      "type": "string",
      "description": "Why this outcome"
    }
  },
  "required": [
    "memory_id",
    "outcome"
  ],
  "additionalProperties": false
}
