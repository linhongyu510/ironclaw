{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Sheets preview output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spreadsheet_id",
    "title",
    "url",
    "sheet_name",
    "range",
    "row_count_estimate",
    "column_count_estimate",
    "headers",
    "rows",
    "sampled_row_count",
    "sampled_column_count",
    "truncation"
  ],
  "properties": {
    "spreadsheet_id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "sheet_name": { "type": "string" },
    "range": { "type": "string" },
    "row_count_estimate": { "type": "integer", "minimum": 0 },
    "column_count_estimate": { "type": "integer", "minimum": 0 },
    "headers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {}
      }
    },
    "sampled_row_count": { "type": "integer", "minimum": 0 },
    "sampled_column_count": { "type": "integer", "minimum": 0 },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_omitted",
        "columns_omitted",
        "cells_truncated",
        "metadata_fields_truncated",
        "aggregate_limit_reached"
      ],
      "properties": {
        "rows_omitted": { "type": "integer", "minimum": 0 },
        "columns_omitted": { "type": "integer", "minimum": 0 },
        "cells_truncated": { "type": "integer", "minimum": 0 },
        "metadata_fields_truncated": { "type": "integer", "minimum": 0 },
        "aggregate_limit_reached": { "type": "boolean" }
      }
    }
  }
}
