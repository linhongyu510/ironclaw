# Python-only worker image for IronClaw Reborn user-sandbox execution.
#
# Build:
#   docker build -f Dockerfile.process-sandbox -t ironclaw-process-sandbox:dev .
#
# The host starts a persistent container per user and mounts only that user's
# workspace. PR1 runs with `--network none` and passes no caller environment or
# credentials into the worker.

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       tini \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/process-sandbox-entrypoint.sh /usr/local/bin/process-sandbox-entrypoint
RUN chmod +x /usr/local/bin/process-sandbox-entrypoint \
    && useradd -m -u 1000 -s /bin/bash sandbox \
    && mkdir -p /workspace/.home \
    && chown -R sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/process-sandbox-entrypoint"]
CMD ["sh", "-c", "echo missing command >&2; exit 64"]
